        </mxCell>
        <mxCell id="uNBo-7ra3uC1L5kDhG56-12" value="+ PlayingField - контролирует полу, то есть удаление заполненых строк, покрас ячеек и проверки может ли фигура встать на новое место" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="uNBo-7ra3uC1L5kDhG56-8" vertex="1">

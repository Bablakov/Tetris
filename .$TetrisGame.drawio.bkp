        <mxCell id="uNBo-7ra3uC1L5kDhG56-4" value="+ Cell - включение отключение ячейки заполнения и хранит информацию о заполнении" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="uNBo-7ra3uC1L5kDhG56-1" vertex="1">
